# =================================================================
# Atrilora Technologies — Email & Environment Configuration
# =================================================================

# The email address that will receive incoming contact form submissions:
CONTACT_EMAIL=abhiramkurambhatti@gmail.com

# -----------------------------------------------------------------
# OPTION 1: Resend (Recommended for production on Vercel)
# Sign up at https://resend.com and grab an API key
# -----------------------------------------------------------------
# RESEND_API_KEY=re_123456789
# RESEND_FROM="Atrilora Inquiries <onboarding@resend.dev>"

# -----------------------------------------------------------------
# OPTION 2: Gmail SMTP with Google App Password
# 1. Turn on 2-Step Verification in Google Account
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------
# SMTP_USER=abhiramkurambhatti@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# -----------------------------------------------------------------
# OPTION 3: Custom SMTP (Hostinger, Zoho, AWS SES, cPanel)
# -----------------------------------------------------------------
# SMTP_HOST=smtp.yourhost.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=contact@atrilora.com
# SMTP_PASS=your_smtp_password

# -----------------------------------------------------------------
# OPTION 4: Zero-Setup Direct Forwarding (Default fallback)
# If no API key or SMTP is configured above, the form automatically
# delivers submissions directly to CONTACT_EMAIL via FormSubmit API!
# (Check your inbox for a one-time activation confirmation if needed).
# -----------------------------------------------------------------
